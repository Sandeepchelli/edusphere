# Node modules (never commit these)
node_modules/
frontend/node_modules/
backend/node_modules/

# Frontend build output (Vercel builds it automatically)
frontend/dist/
frontend/dist-ssr/

# Environment secrets (NEVER commit)
.env
backend/.env
frontend/.env.local
frontend/.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# SQLite database (optional - comment out if you want to commit initial DB)
# backend/data/edusphere.db
